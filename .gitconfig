[core]
	excludesfile = ~/dotfiles/global.gitignore
	hooksPath=~/dotfiles/git-hooks
[user]
	name = Lawrence Forooghian
	# Email is set in ~/.gitconfig_local, e.g.
	# email = lawrence@forooghian.com
	useConfigOnly = true
    # See "Use SSH key for signing commits" below.
	signingkey = ~/.ssh/id_ed25519.pub
[rebase]
	autoStash = true
	autoSquash = true
[gpg]
    # Use SSH key for signing commits (I was previously using GPG, and then
    # this mysteriously broke one day with "signing failed: Inappropriate ioctl
    # for device". I didn't figure out why. But I think that SSH is maybe a
    # better idea anyway because it means not having to transfer my personal
    # GPG key onto my work machine, or set up a new GPG key on it.)
	format = ssh
[commit]
	verbose = true
	gpgsign = true
[include]
	path = ~/.gitconfig_local
[absorb]
	maxStack = 1000
[grep]
	patternType = perl

[alias]
	# https://tekin.co.uk/2020/01/clean-up-your-git-branches-and-repositories
	delete-merged = !git branch --merged master | egrep -v \"(^\\*|^  master$)\" | xargs git branch --delete
[cinnabar]
	version-check = 1591461021
	helper = /Users/lawrence/.mozbuild/git-cinnabar/git-cinnabar-helper
[pull]
	ff = only
[push]
	autoSetupRemote = true
[merge "npm-merge-driver"]
	name = automatically merge npm lockfiles
	driver = npx npm-merge-driver merge %A %O %B %P
[init]
	defaultBranch = main
[advice]
	skippedCherryPicks = false
[format]
	# Shows committer and author, each with date
	pretty = fuller
